/* display.prism_rt's compute passes (xgpu_vulkan_rt.c; docs/prism_rt.md),
in Vulkan's GLSL: tools/vulkan_rt_shaders.py makes xgpu_vulkan_rt_shaders.c
of them. Not compiled into the game.

Both read world AO's pre-pass inputs (xgpu.h's XGPU_AMBIENT_OCCLUSION_WORLD_
INPUTS: each pixel's octahedral normal, its flags with the lightmap pass's
bit, its distance from the eye) and the pass block (struct rt_pass in
xgpu_vulkan_rt.c, field for field). A texel of the output is a pixel's, or
at scale 2 its 2x2 block's nearest drawn pixel's, as world AO's pass finds
it (world_ao_shading.c's world_ao_pass_position).

trace: at each texel, rays through the frame's acceleration structure (a
ray query each, no pipeline): toward the sun, the moving casters (the
objects' instances, mask 4) and the structure (mask 1), and about the
normal for the ambient occlusion (the level's pixels: the objects alone, it
never darkens itself; the objects': the objects, their own creases among
them, and the structure close by). Written raw: x the sun's visibility
through the objects, y through the structure, z the occlusion, w the
pixel's distance (0 none).

resolve: the raw texels filtered (a 5x5 cross-bilateral by distance and
normal, display.prism_rt_denoiser "spatiotemporal"; none otherwise),
blended into the last frame's (reprojected by its camera, kept where the
distance is within 5%: "temporal" and "spatiotemporal"), and written as
world AO's pass writes its texels (x the light's factor the surfaces'
occlusion slot multiplies, y the distance, zw the octahedral normal), so
the surfaces read it unchanged: the sun's share CE's lightmap gave
(strength.x of a sunlit lightmap's, strength.y of a model's) taken where
an object blocks it and the structure does not (CE's own shadows are in the
lightmap: never darkened again), times the occlusion. */

static const char trace_source[] =
	"#version 460\n"
	"#extension GL_EXT_ray_query : require\n"
	"layout(local_size_x = 8, local_size_y = 8) in;\n"
	"layout(set = 0, binding = 0) uniform usampler2D inputs;\n"
	"layout(set = 0, binding = 1) uniform accelerationStructureEXT scene;\n"
	"layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D raw;\n"
	"layout(set = 0, binding = 3, std140) uniform Pass\n"
	"{\n"
	"    vec4 camera[4];\n"
	"    ivec4 corners;\n"
	"    vec4 previous[4];\n"
	"    ivec4 previous_corners;\n"
	"    vec4 sun;\n"
	"    vec4 strength;\n"
	"    vec4 rays;\n"
	"    uvec4 info;\n"
	"    ivec4 size;\n"
	"} pass;\n"
	"\n"
	"vec3 unfold(vec2 f)\n"
	"{\n"
	"    vec3 n = vec3(f, 1.0 - abs(f.x) - abs(f.y));\n"
	"    float t = max(-n.z, 0.0);\n"
	"    n.x += n.x >= 0.0 ? -t : t;\n"
	"    n.y += n.y >= 0.0 ? -t : t;\n"
	"    return normalize(n);\n"
	"}\n"
	"\n"
	"float hash(uvec3 v)\n"
	"{\n"
	"    v = v * 1664525u + 1013904223u;\n"
	"    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;\n"
	"    v ^= v >> 16u;\n"
	"    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;\n"
	"    return float(v.x & 0xffffffu) / 16777216.0;\n"
	"}\n"
	"\n"
	"bool blocked(vec3 origin, vec3 direction, float t_max, uint mask)\n"
	"{\n"
	"    rayQueryEXT q;\n"
	"    rayQueryInitializeEXT(q, scene, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT, mask,\n"
	"        origin, 0.0, direction, t_max);\n"
	"    while (rayQueryProceedEXT(q)) { }\n"
	"    return rayQueryGetIntersectionTypeEXT(q, true) != gl_RayQueryCommittedIntersectionNoneEXT;\n"
	"}\n"
	"\n"
	"float nearest(vec3 origin, vec3 direction, float t_max, uint mask)\n"
	"{\n"
	"    rayQueryEXT q;\n"
	"    rayQueryInitializeEXT(q, scene, gl_RayFlagsOpaqueEXT, mask, origin, 0.0, direction, t_max);\n"
	"    while (rayQueryProceedEXT(q)) { }\n"
	"    if (rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionNoneEXT)\n"
	"        return t_max;\n"
	"    return rayQueryGetIntersectionTEXT(q, true);\n"
	"}\n"
	"\n"
	"void main()\n"
	"{\n"
	"    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);\n"
	"    int scale = pass.size.z;\n"
	"    ivec2 full = pass.size.xy;\n"
	"    if (texel.x >= (full.x + scale - 1) / scale || texel.y >= (full.y + scale - 1) / scale)\n"
	"        return;\n"
	"    uvec4 best = uvec4(0u);\n"
	"    ivec2 at = texel * scale;\n"
	"    float best_distance = 3.0e38;\n"
	"    for (int j = 0; j < scale; j++)\n"
	"        for (int i = 0; i < scale; i++)\n"
	"        {\n"
	"            ivec2 p = min(texel * scale + ivec2(i, j), full - 1);\n"
	"            uvec4 w = texelFetch(inputs, p, 0);\n"
	"            float d = uintBitsToFloat(w.z);\n"
	"            if ((w.y & 0x400u) != 0u && d > 0.0 && d < best_distance)\n"
	"            {\n"
	"                best = w;\n"
	"                best_distance = d;\n"
	"                at = p;\n"
	"            }\n"
	"        }\n"
	"    if ((best.y & 0x400u) == 0u)\n"
	"    {\n"
	"        imageStore(raw, texel, vec4(1.0, 1.0, 1.0, 0.0));\n"
	"        return;\n"
	"    }\n"
	"    vec3 n = unfold(unpackSnorm2x16(best.x));\n"
	"    bool level = (best.y & 0x100u) != 0u;\n"
	"    vec2 s = 2.0 * (vec2(at) + 0.5 - vec2(pass.corners.xy)) / vec2(pass.corners.zw - pass.corners.xy) - 1.0;\n"
	"    vec3 ray = normalize(pass.camera[1].xyz + s.x * pass.camera[2].xyz + s.y * pass.camera[3].xyz);\n"
	"    vec3 p = pass.camera[0].xyz + best_distance * ray;\n"
	"    /* (a surface seen from behind: its normal toward the eye) */\n"
	"    if (dot(n, ray) > 0.0)\n"
	"        n = -n;\n"
	"    float bias = 0.02 + 0.0015 * best_distance;\n"
	"    vec3 origin = p + n * bias;\n"
	"    uint frame = pass.info.x;\n"
	"    float v_m = 1.0, v_s = 1.0;\n"
	"    int sun_rays = int(pass.rays.x);\n"
	"    if (pass.sun.w > 0.0 && dot(n, pass.sun.xyz) > 0.0)\n"
	"    {\n"
	"        vec3 t = normalize(abs(pass.sun.z) < 0.95 ? cross(pass.sun.xyz, vec3(0.0, 0.0, 1.0)) :\n"
	"            cross(pass.sun.xyz, vec3(1.0, 0.0, 0.0)));\n"
	"        vec3 b = cross(pass.sun.xyz, t);\n"
	"        float m = 0.0, st = 0.0;\n"
	"        for (int r = 0; r < sun_rays; r++)\n"
	"        {\n"
	"            float u = hash(uvec3(uvec2(at), frame * 8u + uint(r)));\n"
	"            float a = hash(uvec3(uvec2(at) + 7u, frame * 8u + uint(r) + 3u)) * 6.2831853;\n"
	"            vec3 d = normalize(pass.sun.xyz + pass.strength.z * sqrt(u) * (cos(a) * t + sin(a) * b));\n"
	"            m += blocked(origin, d, pass.rays.z, 4u) ? 0.0 : 1.0;\n"
	"            st += blocked(origin, d, pass.rays.w, 1u) ? 0.0 : 1.0;\n"
	"        }\n"
	"        v_m = m / float(max(sun_rays, 1));\n"
	"        v_s = st / float(max(sun_rays, 1));\n"
	"    }\n"

	"    /* the ambient occlusion: cosine-weighted rays about the normal, a hit at\n"
	"    t counting 1 - (t / reach)^2, as world AO's traced objects count */\n"
	"    int ao_rays = int(pass.rays.y);\n"
	"    float reach = level ? 2.0 : 1.5;\n"
	"    float occluded = 0.0;\n"
	"    vec3 t0 = normalize(abs(n.z) < 0.95 ? cross(n, vec3(0.0, 0.0, 1.0)) : cross(n, vec3(1.0, 0.0, 0.0)));\n"
	"    vec3 b0 = cross(n, t0);\n"
	"    for (int r = 0; r < ao_rays; r++)\n"
	"    {\n"
	"        float u = (float(r) + hash(uvec3(uvec2(at), frame * 16u + uint(r) + 101u))) / float(ao_rays);\n"
	"        float a = hash(uvec3(uvec2(at) + 13u, frame * 16u + uint(r) + 57u)) * 6.2831853;\n"
	"        vec3 d = normalize(sqrt(u) * (cos(a) * t0 + sin(a) * b0) + sqrt(max(1.0 - u, 0.0)) * n);\n"
	"        float hit = nearest(origin, d, reach, 4u);\n"
	"        if (!level)\n"
	"            hit = min(hit, nearest(origin, d, 0.5, 1u) < 0.5 ? 0.5 * reach * nearest(origin, d, 0.5, 1u) / 0.5 :\n"
	"                reach);\n"
	"        if (hit < reach)\n"
	"            occluded += 1.0 - (hit / reach) * (hit / reach);\n"
	"    }\n"
	"    float ao = ao_rays > 0 ? 1.0 - occluded / float(ao_rays) : 1.0;\n"
	"    imageStore(raw, texel, vec4(v_m, v_s, ao, best_distance));\n"
	"}\n";

static const char resolve_source[] =
	"#version 460\n"
	"layout(local_size_x = 8, local_size_y = 8) in;\n"
	"layout(set = 0, binding = 0) uniform usampler2D inputs;\n"
	"layout(set = 0, binding = 1) uniform sampler2D raw;\n"
	"layout(set = 0, binding = 2) uniform sampler2D history;\n"
	"layout(set = 0, binding = 3, rgba32f) uniform writeonly image2D state;\n"
	"layout(set = 0, binding = 4, rgba32f) uniform writeonly image2D result;\n"
	"layout(set = 0, binding = 5, std140) uniform Pass\n"
	"{\n"
	"    vec4 camera[4];\n"
	"    ivec4 corners;\n"
	"    vec4 previous[4];\n"
	"    ivec4 previous_corners;\n"
	"    vec4 sun;\n"
	"    vec4 strength;\n"
	"    vec4 rays;\n"
	"    uvec4 info;\n"
	"    ivec4 size;\n"
	"} pass;\n"
	"\n"
	"vec3 unfold(vec2 f)\n"
	"{\n"
	"    vec3 n = vec3(f, 1.0 - abs(f.x) - abs(f.y));\n"
	"    float t = max(-n.z, 0.0);\n"
	"    n.x += n.x >= 0.0 ? -t : t;\n"
	"    n.y += n.y >= 0.0 ? -t : t;\n"
	"    return normalize(n);\n"
	"}\n"
	"\n"
	"void main()\n"
	"{\n"
	"    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);\n"
	"    int scale = pass.size.z;\n"
	"    ivec2 full = pass.size.xy;\n"
	"    ivec2 extent = (full + scale - 1) / scale;\n"
	"    if (texel.x >= extent.x || texel.y >= extent.y)\n"
	"        return;\n"
	"    vec4 centre = texelFetch(raw, texel, 0);\n"
	"    /* (the texel's pixel again: the 2x2 block's nearest, its inputs) */\n"
	"    uvec4 best = uvec4(0u);\n"
	"    ivec2 at = texel * scale;\n"
	"    float best_distance = 3.0e38;\n"
	"    for (int j = 0; j < scale; j++)\n"
	"        for (int i = 0; i < scale; i++)\n"
	"        {\n"
	"            ivec2 p = min(texel * scale + ivec2(i, j), full - 1);\n"
	"            uvec4 w = texelFetch(inputs, p, 0);\n"
	"            float d = uintBitsToFloat(w.z);\n"
	"            if ((w.y & 0x400u) != 0u && d > 0.0 && d < best_distance)\n"
	"            {\n"
	"                best = w;\n"
	"                best_distance = d;\n"
	"                at = p;\n"
	"            }\n"
	"        }\n"
	"    /* (the raw texel's distance is a half float: the inputs' is whole) */\n"
	"    centre.w = (best.y & 0x400u) != 0u ? best_distance : 0.0;\n"
	"    if (centre.w <= 0.0)\n"
	"    {\n"
	"        imageStore(state, texel, vec4(1.0, 1.0, 1.0, 0.0));\n"
	"        imageStore(result, texel, vec4(1.0, 0.0, 0.0, 0.0));\n"
	"        return;\n"
	"    }\n"
	"    vec2 octahedral = unpackSnorm2x16(best.x);\n"
	"    vec3 n = unfold(octahedral);\n"
	"    bool level = (best.y & 0x100u) != 0u;\n"
	"    vec4 value = centre;\n"
	"    /* (spatial: a 5x5 cross-bilateral by the neighbours' distances and\n"
	"    normals, as world AO's upsample weighs them) */\n"
	"    if (pass.info.y == 0u)\n"
	"    {\n"
	"        vec3 sum = vec3(0.0);\n"
	"        float weights = 0.0;\n"
	"        for (int j = -2; j <= 2; j++)\n"
	"            for (int i = -2; i <= 2; i++)\n"
	"            {\n"
	"                ivec2 q = clamp(texel + ivec2(i, j), ivec2(0), extent - 1);\n"
	"                vec4 other = texelFetch(raw, q, 0);\n"
	"                if (other.w <= 0.0)\n"
	"                    continue;\n"
	"                uvec4 w = texelFetch(inputs, min(q * scale, full - 1), 0);\n"
	"                vec3 on = unfold(unpackSnorm2x16(w.x));\n"
	"                float relative = abs(other.w / centre.w - 1.0) * 50.0;\n"
	"                float along = max(dot(n, on), 0.0);\n"
	"                along *= along; along *= along;\n"
	"                float weight = along / (1.0 + relative * relative) * exp(-0.18 * float(i * i + j * j));\n"
	"                sum += weight * other.xyz;\n"
	"                weights += weight;\n"
	"            }\n"
	"        if (weights > 1.0e-4)\n"
	"            value.xyz = sum / weights;\n"
	"    }\n"
	"    /* (temporal: the last frame's at the point, reprojected by its camera) */\n"
	"    if (pass.info.z != 0u && pass.info.y != 2u)\n"
	"    {\n"
	"        vec2 s = 2.0 * (vec2(at) + 0.5 - vec2(pass.corners.xy)) / vec2(pass.corners.zw - pass.corners.xy) - 1.0;\n"
	"        vec3 ray = normalize(pass.camera[1].xyz + s.x * pass.camera[2].xyz + s.y * pass.camera[3].xyz);\n"
	"        vec3 p = pass.camera[0].xyz + centre.w * ray;\n"
	"        vec3 v = p - pass.previous[0].xyz;\n"
	"        float along = dot(v, pass.previous[1].xyz);\n"
	"        if (along > 0.0)\n"
	"        {\n"
	"            vec3 u = v / along - pass.previous[1].xyz;\n"
	"            vec2 ps = vec2(dot(u, pass.previous[2].xyz) / dot(pass.previous[2].xyz, pass.previous[2].xyz),\n"
	"                dot(u, pass.previous[3].xyz) / dot(pass.previous[3].xyz, pass.previous[3].xyz));\n"
	"            vec2 pixel = vec2(pass.previous_corners.xy) + (ps + 1.0) * 0.5 *\n"
	"                vec2(pass.previous_corners.zw - pass.previous_corners.xy);\n"
	"            vec2 uv = pixel / vec2(scale) / vec2(extent);\n"
	"            if (all(greaterThanEqual(uv, vec2(0.0))) && all(lessThan(uv, vec2(1.0))))\n"
	"            {\n"
	"                vec4 old = texelFetch(history, ivec2(uv * vec2(extent)), 0);\n"
	"                float old_distance = length(v);\n"
	"                if (old.w > 0.0 && abs(old.w - old_distance) < 0.05 * old_distance)\n"
	"                {\n"
	"                    float alpha = pass.strength.w;\n"
	"                    value.xyz = mix(old.xyz, value.xyz, alpha);\n"
	"                }\n"
	"            }\n"
	"        }\n"
	"    }\n"
	"    imageStore(state, texel, vec4(value.xyz, centre.w));\n"
	"    float facing = smoothstep(0.0, 0.25, dot(n, pass.sun.xyz));\n"
	"    float share = level ? pass.strength.x : pass.strength.y;\n"
	"    float shadow = 1.0 - share * (1.0 - value.x) * value.y * facing * pass.sun.w;\n"
	"    float ao = level ? mix(1.0, max(value.z, 0.2), 0.8) : max(value.z, 0.2);\n"
	"    uint view = pass.info.w;\n"
	"    float light = view == 1u ? shadow : view == 2u ? ao : view == 3u ? value.y : view == 4u ? value.x :\n"
	"        shadow * ao;\n"
	"    imageStore(result, texel, vec4(light, centre.w, octahedral));\n"
	"}\n";
