	"                    back += 1.0;\n"
	"                    radiance = vec3(0.0);\n"
	"                    nh = vec3(0.0);\n"
	"                }\n"
	"                else\n"
	"                    nh = -nh;\n"
	"            }\n"
	"            if (dot(nh, nh) > 0.0)\n"
	"            {\n"
	"                vec3 h = p + d * t + nh * 0.03;\n"
	"                float lit = max(dot(nh, pass.sun.xyz), 0.0) * pass.sun.w;\n"
	"                if (lit > 0.0)\n"
	"                {\n"
	"                    rayQueryEXT s;\n"
	"                    rayQueryInitializeEXT(s, scene, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT, 5u,\n"
	"                        h, 0.0, pass.sun.xyz, 800.0);\n"
	"                    while (rayQueryProceedEXT(s)) { }\n"
	"                    if (rayQueryGetIntersectionTypeEXT(s, true) != gl_RayQueryCommittedIntersectionNoneEXT)\n"
	"                        lit = 0.0;\n"
	"                }\n"
	"                radiance = 0.3 * (pass.sun_radiance.rgb * lit + irradiance(h, nh) * 0.318310);\n"
	"            }\n"
	"        }\n"
	"        vec4 y = vec4(0.282095, 0.488603 * d.y, 0.488603 * d.z, 0.488603 * d.x);\n"
	"        acc[0] += radiance.r * y;\n"
	"        acc[1] += radiance.g * y;\n"
	"        acc[2] += radiance.b * y;\n"
	"    }\n"
	"    sh[lane][0] = acc[0];\n"
	"    sh[lane][1] = acc[1];\n"
	"    sh[lane][2] = acc[2];\n"
	"    backs[lane] = back;\n"
	"    barrier();\n"
	"    for (uint stride = 32u; stride > 0u; stride >>= 1u)\n"
	"    {\n"
	"        if (lane < stride)\n"
	"        {\n"
	"            sh[lane][0] += sh[lane + stride][0];\n"
	"            sh[lane][1] += sh[lane + stride][1];\n"
	"            sh[lane][2] += sh[lane + stride][2];\n"
	"            backs[lane] += backs[lane + stride];\n"
	"        }\n"
	"        barrier();\n"
	"    }\n"
	"    if (lane != 0u)\n"
	"        return;\n"
	"    float scale = 12.566371 / float(ray_count);\n"
	"    vec4 where = probes[index * 4u + 3u];\n"
	"    bool fresh = where.w <= 0.0 || any(greaterThan(abs(where.xyz - p), vec3(0.01)));\n"
	"    /* (inside the level: a quarter of its rays or more saw a face's back) */\n"
	"    bool inside = backs[0] > 0.25 * float(ray_count);\n"
	"    float keep = fresh ? 0.0 : 0.9;\n"
	"    /* (a sample gone wrong never written: one NaN would spread to every\n"
	"    probe through the bounces) */\n"
	"    for (int k = 0; k < 3; k++)\n"
	"    {\n"
	"        vec4 old = probes[index * 4u + uint(k)];\n"
	"        vec4 value = sh[0][k] * scale;\n"
	"        if (any(isnan(value)) || any(isinf(value)))\n"
	"            value = vec4(0.0);\n"
	"        if (any(isnan(old)) || any(isinf(old)))\n"
	"            keep = 0.0;\n"
	"        probes[index * 4u + uint(k)] = mix(value, old, keep);\n"
	"    }\n"
	"    probes[index * 4u + 3u] = vec4(p, inside ? 0.0 : 1.0);\n"
	"}\n";

/* ---------- display.prism_rt "pathtraced" (docs/prism_rt.md, "Path tracing")

path: at every pixel of the pre-pass, from its raster G-buffer: the sun
through the structure alone and through everything; paths of 1 to 4
bounces (a grey dielectric, diffuse and a GGX lobe, next events to the sun
and a dynamic light, the last bounce ending in gi's probes, the sky past
the level), their static light as CE baked it (the first ray through the
structure alone where an object took it) and with everything, and their
dynamic lights' bounce apart; ReSTIR DI over the dynamic lights
(candidates, the last frame's reservoirs at the point and about it,
reweighed), the one kept traced for its shadow. Written: raw0 x the
static light's numerator, y its denominator, w the distance; raw1 the
dynamic light's change (its bounce, less the shadows of the lights CE adds
unshadowed); the reservoirs.

accumulate: the temporal half of the denoiser (each texel blended into its
reprojected history by 1 / its length).

atrous: the spatial half (three edge-avoiding a-trous passes), the last
writing what the surfaces read (xgpu.h's XGPU_AMBIENT_OCCLUSION_RT_LIGHT):
x the factor of CE's light, yzw the light added. */

static const char path_source[] =
	"#version 460\n"
	"#extension GL_EXT_ray_query : require\n"
