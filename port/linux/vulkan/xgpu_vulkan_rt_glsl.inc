	"{\n"
	"    t = normalize(abs(n.z) < 0.95 ? cross(n, vec3(0.0, 0.0, 1.0)) : cross(n, vec3(1.0, 0.0, 0.0)));\n"
	"    b = cross(n, t);\n"
	"}\n"
	"vec3 cosine_dir(vec3 n)\n"
	"{\n"
	"    vec3 t, b;\n"
	"    basis(n, t, b);\n"
	"    float u = rnd(), a = rnd() * 6.2831853;\n"
	"    return normalize(sqrt(u) * (cos(a) * t + sin(a) * b) + sqrt(max(1.0 - u, 0.0)) * n);\n"
	"}\n"
	"/* the next direction (0.8 diffuse, 0.2 the lobe) and its throughput, the\n"
	"BRDF by the cosine over the mixed density */\n"
	"vec3 bounce(vec3 n, vec3 wo, float albedo, out vec3 wi)\n"
	"{\n"
	"    if (rnd() < 0.8)\n"
	"        wi = cosine_dir(n);\n"
	"    else\n"
	"    {\n"
	"        vec3 t, b;\n"
	"        basis(n, t, b);\n"
	"        float u = rnd(), a = rnd() * 6.2831853;\n"
	"        float c2 = (1.0 - u) / (1.0 + (ALPHA * ALPHA - 1.0) * u);\n"
	"        float s = sqrt(max(1.0 - c2, 0.0));\n"
	"        vec3 h = normalize(s * cos(a) * t + s * sin(a) * b + sqrt(c2) * n);\n"
	"        wi = reflect(-wo, h);\n"
	"    }\n"
	"    float nl = dot(n, wi);\n"
	"    if (nl <= 0.0)\n"
	"        return vec3(0.0);\n"
	"    vec3 h = normalize(wo + wi);\n"
	"    float nh = max(dot(n, h), 0.0), vh = max(dot(wo, h), 1.0e-4);\n"
	"    float pdf = 0.8 * nl / 3.14159265 + 0.2 * ggx_d(nh) * nh / (4.0 * vh);\n"
	"    return brdf(n, wo, wi, albedo) * nl / max(pdf, 1.0e-4);\n"
	"}\n"
	"\n"
	"/* a hit's light: the sun (through everything), one dynamic light picked by\n"
	"its power at the hit (shadowed), as next events: static (the sun's, in the\n"
	"sky's units) and dynamic (CE's lights' units) apart */\n"
	"void hit_light(vec3 h, vec3 nh, vec3 wo, float albedo, out vec3 ls, out vec3 ld)\n"
	"{\n"
	"    ls = vec3(0.0);\n"
	"    ld = vec3(0.0);\n"
	"    vec3 o = h + nh * 0.03;\n"
	"    if (pass.sun.w > 0.0 && dot(nh, pass.sun.xyz) > 0.0 && !blocked(o, pass.sun.xyz, pass.rays.w, 5u))\n"
	"        ls = pass.sun_radiance.rgb * brdf(nh, wo, pass.sun.xyz, albedo) * dot(nh, pass.sun.xyz);\n"
	"    int count = int(pass.pt.w);\n"
	"    if (count > 0)\n"
	"    {\n"
	"        int i = min(int(rnd() * float(count)), count - 1);\n"
	"        vec3 l;\n"
	"        float d;\n"
	"        vec3 e = light_at(i, h, nh, l, d);\n"
	"        if (luma(e) > 1.0e-5 && !blocked(o, l, max(d - 0.05, 0.0), 5u))\n"
	"            ld = e * float(count) * brdf(nh, wo, l, albedo);\n"
	"    }\n"
	"}\n"
	"\n"
	"struct Reservoir\n"
	"{\n"
	"    int light;\n"
	"    float wsum;\n"
	"    float m;\n"
	"    float w;\n"
	"};\n"
	"\n"
	"bool reservoir_add(inout Reservoir r, int light, float weight, float m)\n"
	"{\n"
	"    r.wsum += weight;\n"
	"    r.m += m;\n"
	"    if (weight > 0.0 && rnd() * r.wsum <= weight)\n"
	"    {\n"
	"        r.light = light;\n"
	"        return true;\n"
	"    }\n"
	"    return false;\n"
	"}\n"
	"\n"
	"void main()\n"
	"{\n"
	"    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);\n"
	"    ivec2 full = pass.size.xy;\n"
	"    if (texel.x >= full.x || texel.y >= full.y)\n"
	"        return;\n"
	"    uvec4 w = texelFetch(inputs, texel, 0);\n"
	"    float distance = uintBitsToFloat(w.z);\n"
	"    if ((w.y & 0x400u) == 0u || !(distance > 0.0))\n"
	"    {\n"
	"        imageStore(raw0, texel, vec4(0.0, 0.0, 0.0, 0.0));\n"
	"        imageStore(raw1, texel, vec4(0.0));\n"
	"        imageStore(reservoirs, texel, vec4(-1.0, 0.0, 0.0, 0.0));\n"
	"        return;\n"
	"    }\n"
	"    /* (display.prism_rt_rate \"half\", or quality low: half the pixels a\n"
	"    frame, in a checkerboard that turns each frame; the others keep their\n"
	"    history, the spatial passes fill them where it has none) */\n"
	"    if (pass.pt2.w < 0.0 && ((texel.x + texel.y + int(pass.info.x)) & 1) != 0)\n"
	"    {\n"
	"        imageStore(raw0, texel, vec4(0.0, 0.0, 0.0, distance));\n"
	"        imageStore(raw1, texel, vec4(0.0));\n"
	"        imageStore(reservoirs, texel, vec4(-1.0, 0.0, 0.0, 0.0));\n"
	"        return;\n"
	"    }\n"
	"    seed = uint(texel.x) * 1973u + uint(texel.y) * 9277u + pass.info.x * 26699u;\n"
	"    vec3 n = unfold(unpackSnorm2x16(w.x));\n"
	"    bool level = (w.y & 0x100u) != 0u;\n"
	"    vec3 ray = eye_ray(texel);\n"
	"    vec3 p = pass.camera[0].xyz + distance * ray;\n"
	"    if (dot(n, ray) > 0.0)\n"
	"        n = -n;\n"
	"    vec3 wo = -ray;\n"
	"    float bias = (level ? 0.02 : 0.05) + 0.0015 * distance;\n"
	"    vec3 origin = p + n * bias;\n"
	"    float albedo = pass.pt2.z;\n"
	"    int bounces = int(pass.pt.x), paths = int(pass.pt.y);\n"
	"\n"
	"    /* the sun: through the structure alone (the light CE baked, its\n"
	"    shadows) and through everything (the objects' shadows too) */\n"
	"    float sun_all = 0.0, sun_structure = 0.0;\n"
	"    int sun_rays = int(pass.rays.x);\n"
	"    float facing = max(dot(n, pass.sun.xyz), 0.0);\n"
	"    if (pass.sun.w > 0.0 && facing > 0.0)\n"
	"    {\n"
	"        vec3 t, b;\n"
	"        basis(pass.sun.xyz, t, b);\n"
	"        for (int r = 0; r < sun_rays; r++)\n"
	"        {\n"
	"            float u = rnd(), a = rnd() * 6.2831853;\n"
	"            vec3 d = normalize(pass.sun.xyz + pass.strength.z * sqrt(u) * (cos(a) * t + sin(a) * b));\n"
	"            bool s = blocked(origin, d, pass.rays.w, 1u);\n"
	"            sun_structure += s ? 0.0 : 1.0;\n"
	"            sun_all += s || blocked(origin, d, pass.rays.z, 4u) ? 0.0 : 1.0;\n"
	"        }\n"
	"        sun_all /= float(max(sun_rays, 1));\n"
	"        sun_structure /= float(max(sun_rays, 1));\n"
	"    }\n"
	"    float sun_light = luma(pass.sun_radiance.rgb) * facing;\n"
	"\n"
	"    /* the paths: their static light (the sky and the sun, bounced) with\n"
	"    everything and as CE baked it (the first ray through the structure\n"
	"    alone, where an object was in its way), and their dynamic light (the\n"
	"    lights' bounce) */\n"
	"    float full_static = 0.0, base_static = 0.0;\n"
	"    vec3 dynamic_bounce = vec3(0.0);\n"
	"    vec3 sky = pass.sky.rgb;\n"
	"    for (int k = 0; k < paths; k++)\n"
	"    {\n"
	"        vec3 d = cosine_dir(n);\n"
	"        vec3 nh;\n"
	"        bool hit_level;\n"
	"        float t = hit(origin, d, 64.0, 5u, nh, hit_level);\n"
	"        bool first_level = hit_level;\n"
	"        vec3 ls_total = vec3(0.0), ld_total = vec3(0.0);\n"
	"        /* (the first segment: the irradiance estimator of a cosine ray is pi L) */\n"
	"        if (t < 0.0)\n"
	"        {\n"
	"            ls_total = sky;\n"
	"            base_static += luma(sky);\n"
	"        }\n"
	"        else\n"
	"        {\n"
	"            vec3 throughput = vec3(3.14159265);\n"
	"            vec3 h = origin + d * t;\n"
	"            vec3 nx = nh;\n"
	"            vec3 wox = -d;\n"
	"            bool alive = dot(nx, nx) > 0.0;\n"
	"            /* (CE's: the same ray through the structure alone, where an\n"
	"            object took it; its hit lit by the sun through the structure\n"
	"            and the probes) */\n"
	"            if (!first_level)\n"
	"            {\n"
	"                vec3 nb;\n"
	"                bool lb;\n"
	"                float tb = hit(origin, d, 64.0, 1u, nb, lb);\n"
	"                if (tb < 0.0)\n"
	"                    base_static += luma(sky);\n"
	"                else if (dot(nb, nb) > 0.0)\n"
	"                {\n"
	"                    vec3 hb = origin + d * tb + nb * 0.03;\n"
	"                    float e = pass.sun.w > 0.0 && dot(nb, pass.sun.xyz) > 0.0 &&\n"
	"                        !blocked(hb, pass.sun.xyz, pass.rays.w, 1u) ? luma(pass.sun_radiance.rgb) *\n"
	"                        dot(nb, pass.sun.xyz) : 0.0;\n"
	"                    vec3 pr = irradiance(hb, nb);\n"
	"                    e += pr.x >= 0.0 ? luma(pr) : 0.3 * luma(sky);\n"
	"                    base_static += albedo * e;\n"
	"                }\n"
	"            }\n"
	"            for (int bounce_index = 0; bounce_index < bounces && alive; bounce_index++)\n"
	"            {\n"
	"                vec3 ls, ld;\n"
	"                hit_light(h, nx, wox, albedo, ls, ld);\n"
	"                ls_total += throughput * ls;\n"
	"                ld_total += throughput * ld;\n"
	"                /* (the last bounce ends in the probes' irradiance: the light\n"
	"                past it) */\n"
	"                if (bounce_index == bounces - 1)\n"
	"                {\n"
	"                    vec3 pr = irradiance(h + nx * 0.1, nx);\n"
	"                    ls_total += throughput * albedo / 3.14159265 * (pr.x >= 0.0 ? pr : 0.3 * sky);\n"
	"                    break;\n"
	"                }\n"
	"                vec3 wi;\n"
	"                vec3 f = bounce(nx, wox, albedo, wi);\n"
	"                if (dot(f, f) <= 0.0)\n"
	"                    break;\n"
	"                throughput *= f;\n"
	"                /* (Russian roulette past the second bounce) */\n"
	"                if (bounce_index >= 1)\n"
	"                {\n"
	"                    float keep = clamp(max(throughput.x, max(throughput.y, throughput.z)) / 3.14159265, 0.05, 0.95);\n"
	"                    if (rnd() > keep)\n"
	"                        break;\n"
	"                    throughput /= keep;\n"
	"                }\n"
	"                vec3 o = h + nx * 0.03;\n"
	"                float t2 = hit(o, wi, 64.0, 5u, nh, hit_level);\n"
	"                if (t2 < 0.0)\n"
	"                {\n"
	"                    ls_total += throughput * sky / 3.14159265;\n"
	"                    break;\n"
	"                }\n"
	"                h = o + wi * t2;\n"
	"                nx = nh;\n"
	"                wox = -wi;\n"
	"                alive = dot(nx, nx) > 0.0;\n"
	"            }\n"
	"            if (first_level)\n"
	"                base_static += luma(ls_total);\n"
	"        }\n"
	"        full_static += luma(ls_total);\n"
	"        dynamic_bounce += ld_total;\n"
	"    }\n"
	"    full_static /= float(max(paths, 1));\n"
	"    base_static /= float(max(paths, 1));\n"
	"    dynamic_bounce /= float(max(paths, 1));\n"
	"\n"
	"    /* ReSTIR DI over the dynamic lights at the pixel: candidates by their\n"
	"    count, the last frame's reservoir at the point and its neighbours\n"
	"    there, their light weighed again here; the one kept is traced for its\n"
	"    shadow. CE adds every light unshadowed: the shadows found take that\n"
	"    light away (by pt2.y) */\n"
	"    int count = int(pass.pt.w);\n"
	"    vec3 shadowed = vec3(0.0);\n"
	"    Reservoir r = Reservoir(-1, 0.0, 0.0, 0.0);\n"
	"    if (count > 0)\n"
	"    {\n"
	"        int candidates = int(pass.pt.z);\n"
	"        for (int c = 0; c < candidates; c++)\n"
	"        {\n"
	"            int i = min(int(rnd() * float(count)), count - 1);\n"
	"            reservoir_add(r, i, target(i, p, n) * float(count), 1.0);\n"
	"        }\n"
	"        float old_distance;\n"
	"        ivec2 q = reproject(p, old_distance);\n"
	"        if (q.x >= 0 && pass.info.z != 0u)\n"
	"        {\n"
	"            int neighbours = int(abs(pass.pt2.w));\n"
	"            for (int s = 0; s <= neighbours; s++)\n"
	"            {\n"
	"                ivec2 o = s == 0 ? q : q + ivec2((rnd() * 2.0 - 1.0) * 10.0, (rnd() * 2.0 - 1.0) * 10.0);\n"
	"                o = clamp(o, ivec2(0), full - 1);\n"
	"                vec4 last = texelFetch(reservoirs_last, o, 0);\n"
	"                int li = int(last.x + 0.5);\n"
	"                if (last.x < -0.5 || li >= count || last.z <= 0.0)\n"
	"                    continue;\n"
	"                float m = min(last.z, 20.0 * float(candidates));\n"
	"                reservoir_add(r, li, target(li, p, n) * last.w * m, m);\n"
	"            }\n"
	"        }\n"
	"        float chosen = target(r.light, p, n);\n"
	"        r.w = chosen > 0.0 ? min(r.wsum / (max(r.m, 1.0) * chosen), 1.0e4) : 0.0;\n"
	"        if (r.light >= 0 && r.w > 0.0)\n"
	"        {\n"
	"            vec3 l;\n"
	"            float d;\n"
	"            vec3 e = light_at(r.light, p, n, l, d);\n"
	"            /* (the unshadowed sum, every light's, as CE draws them) */\n"
	"            vec3 all = vec3(0.0);\n"
	"            for (int i = 0; i < count; i++)\n"
	"            {\n"
	"                vec3 l2;\n"
	"                float d2;\n"
	"                all += light_at(i, p, n, l2, d2);\n"
	"            }\n"
	"            vec3 lit = blocked(origin, l, max(d - 0.05, 0.0), 5u) ? vec3(0.0) : e * r.w;\n"
	"            shadowed = all - lit;\n"
	"        }\n"
	"    }\n"
	"    imageStore(reservoirs, texel, vec4(float(r.light), r.wsum, r.m, r.w));\n"
	"    /* written: the static light's numerator and denominator (in the sky's\n"
	"    units: their ratio is the factor of CE's light), the dynamic light's\n"
	"    change (CE's units: the bounce, less the shadows' share) */\n"
	"    float num = sun_light * sun_all + full_static;\n"
	"    float den = sun_light * sun_structure + base_static;\n"
	"    vec3 add = dynamic_bounce - pass.pt2.y * shadowed;\n"
	"    if (any(isnan(add)) || any(isinf(add)))\n"
	"        add = vec3(0.0);\n"
	"    if (isnan(num) || isinf(num) || isnan(den) || isinf(den))\n"
	"    {\n"
	"        num = 1.0;\n"
	"        den = 1.0;\n"
	"    }\n"
	"    imageStore(raw0, texel, vec4(min(num, 6.0e4), min(den, 6.0e4), 1.0, distance));\n"
	"    imageStore(raw1, texel, vec4(add, 0.0));\n"
	"}\n";

static const char accumulate_source[] =
	"#version 460\n"
	"layout(local_size_x = 8, local_size_y = 8) in;\n"
	"layout(set = 0, binding = 0) uniform usampler2D inputs;\n"
	"layout(set = 0, binding = 1) uniform sampler2D raw0;\n"
	"layout(set = 0, binding = 2) uniform sampler2D raw1;\n"
	"layout(set = 0, binding = 4) uniform sampler2D history0;\n"
	"layout(set = 0, binding = 5) uniform sampler2D history1;\n"
	"layout(set = 0, binding = 6, rgba16f) uniform writeonly image2D state0;\n"
	"layout(set = 0, binding = 7, rgba16f) uniform writeonly image2D state1;\n"
	"layout(set = 0, binding = 3, std140) uniform Pass\n"
	"{\n"
	"    vec4 camera[4];\n"
	"    ivec4 corners;\n"
	"    vec4 previous[4];\n"
	"    ivec4 previous_corners;\n"
	"    vec4 sun;\n"
	"    vec4 strength;\n"
	"    vec4 rays;\n"
	"    uvec4 info;\n"
	"    ivec4 size;\n"
	"    vec4 probe_origin;\n"
	"    ivec4 probe_count;\n"
	"    uvec4 probe_info;\n"
	"    vec4 sky;\n"
	"    vec4 sun_radiance;\n"
	"    uvec4 addresses;\n"
	"    uvec4 addresses2;\n"
	"    vec4 pt;\n"
	"    vec4 pt2;\n"
	"    vec4 lights[192];\n"
	"} pass;\n"
	"\n"
	"vec3 unfold(vec2 f)\n"
	"{\n"
	"    vec3 n = vec3(f, 1.0 - abs(f.x) - abs(f.y));\n"
	"    float t = max(-n.z, 0.0);\n"
	"    n.x += n.x >= 0.0 ? -t : t;\n"
	"    n.y += n.y >= 0.0 ? -t : t;\n"
	"    return normalize(n);\n"
	"}\n"
	"\n"
	"float luma(vec3 c)\n"
	"{\n"
	"    return dot(c, vec3(0.2126, 0.7152, 0.0722));\n"
	"}\n"
	"\n"
	"vec3 eye_ray(ivec2 at)\n"
	"{\n"
	"    vec2 s = 2.0 * (vec2(at) + 0.5 - vec2(pass.corners.xy)) / vec2(pass.corners.zw - pass.corners.xy) - 1.0;\n"
	"    return normalize(pass.camera[1].xyz + s.x * pass.camera[2].xyz + s.y * pass.camera[3].xyz);\n"
	"}\n"
	"\n"
	"/* the last frame's pixel of a point (its camera), or -1 */\n"
	"ivec2 reproject(vec3 p, out float old_distance)\n"
	"{\n"
	"    vec3 v = p - pass.previous[0].xyz;\n"
	"    old_distance = length(v);\n"
	"    float along = dot(v, pass.previous[1].xyz);\n"
	"    if (along <= 0.0)\n"
	"        return ivec2(-1);\n"
	"    vec3 u = v / along - pass.previous[1].xyz;\n"
	"    vec2 ps = vec2(dot(u, pass.previous[2].xyz) / dot(pass.previous[2].xyz, pass.previous[2].xyz),\n"
	"        dot(u, pass.previous[3].xyz) / dot(pass.previous[3].xyz, pass.previous[3].xyz));\n"
	"    vec2 pixel = vec2(pass.previous_corners.xy) + (ps + 1.0) * 0.5 *\n"
	"        vec2(pass.previous_corners.zw - pass.previous_corners.xy);\n"
	"    ivec2 q = ivec2(floor(pixel));\n"
	"    if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, pass.size.xy)))\n"
	"        return ivec2(-1);\n"
	"    return q;\n"
	"}\n"
	"\n"
	"/* the path tracer's temporal pass: each texel's new samples blended into\n"
	"its history at the point the last camera saw it (kept where its distance is\n"
	"within 3%), by 1 / its length (at most 32 frames: pass.pt2's... ), the\n"
	"length kept in state0.z; a disoccluded texel starts again */\n"
	"void main()\n"
	"{\n"
	"    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);\n"
	"    ivec2 full = pass.size.xy;\n"
	"    if (texel.x >= full.x || texel.y >= full.y)\n"
	"        return;\n"
	"    vec4 a = texelFetch(raw0, texel, 0), b = texelFetch(raw1, texel, 0);\n"
	"    uvec4 w = texelFetch(inputs, texel, 0);\n"
	"    float distance = uintBitsToFloat(w.z);\n"
	"    if ((w.y & 0x400u) == 0u || !(distance > 0.0))\n"
	"    {\n"
	"        imageStore(state0, texel, vec4(0.0));\n"
	"        imageStore(state1, texel, vec4(0.0));\n"
	"        return;\n"
	"    }\n"
	"    /* (a texel the checkerboard passed over this frame: its history alone,\n"
	"    length 0 where it has none) */\n"
	"    bool sampled = a.z > 0.5;\n"
	"    float length_ = sampled ? 1.0 : 0.0;\n"
	"    if (!sampled)\n"
	"        a.xy = vec2(0.0);\n"
	"    if (pass.info.z != 0u && pass.info.y != 2u)\n"
	"    {\n"
	"        vec3 p = pass.camera[0].xyz + distance * eye_ray(texel);\n"
	"        float old_distance;\n"
	"        ivec2 q = reproject(p, old_distance);\n"
	"        if (q.x >= 0)\n"
	"        {\n"
	"            vec4 oa = texelFetch(history0, q, 0), ob = texelFetch(history1, q, 0);\n"
	"            if (oa.w > 0.0 && abs(oa.w - old_distance) < 0.03 * old_distance && !any(isnan(oa)) && !any(isnan(ob)))\n"
	"            {\n"
	"                float most = pass.info.y == 1u ? 12.0 : 32.0;\n"
	"                if (!sampled)\n"
	"                {\n"
	"                    length_ = oa.z;\n"
	"                    a.xy = oa.xy;\n"
	"                    b.xyz = ob.xyz;\n"
	"                }\n"
	"                else\n"
	"                {\n"
	"                    length_ = min(oa.z + 1.0, most);\n"
	"                    float alpha = 1.0 / max(length_, 1.0);\n"
	"                    a.xy = mix(oa.xy, a.xy, alpha);\n"
	"                    b.xyz = mix(ob.xyz, b.xyz, alpha);\n"
	"                }\n"
	"            }\n"
	"        }\n"
	"    }\n"
	"    imageStore(state0, texel, vec4(a.xy, length_, distance));\n"
	"    imageStore(state1, texel, vec4(b.xyz, 0.0));\n"
	"}\n";

static const char atrous_source[] =
	"#version 460\n"
	"layout(local_size_x = 8, local_size_y = 8) in;\n"
	"layout(set = 0, binding = 0) uniform usampler2D inputs;\n"
	"layout(set = 0, binding = 1) uniform sampler2D in0;\n"
	"layout(set = 0, binding = 2) uniform sampler2D in1;\n"
	"layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D out0;\n"
	"layout(set = 0, binding = 5, rgba16f) uniform writeonly image2D out1;\n"
	"layout(set = 0, binding = 6, rgba32f) uniform writeonly image2D result;\n"
	"layout(push_constant) uniform Step { int step; int last; } step;\n"
	"layout(set = 0, binding = 3, std140) uniform Pass\n"
	"{\n"
	"    vec4 camera[4];\n"
	"    ivec4 corners;\n"
	"    vec4 previous[4];\n"
	"    ivec4 previous_corners;\n"
	"    vec4 sun;\n"
	"    vec4 strength;\n"
	"    vec4 rays;\n"
	"    uvec4 info;\n"
	"    ivec4 size;\n"
	"    vec4 probe_origin;\n"
	"    ivec4 probe_count;\n"
	"    uvec4 probe_info;\n"
	"    vec4 sky;\n"
	"    vec4 sun_radiance;\n"
	"    uvec4 addresses;\n"
	"    uvec4 addresses2;\n"
	"    vec4 pt;\n"
	"    vec4 pt2;\n"
	"    vec4 lights[192];\n"
	"} pass;\n"
	"\n"
	"vec3 unfold(vec2 f)\n"
	"{\n"
	"    vec3 n = vec3(f, 1.0 - abs(f.x) - abs(f.y));\n"
	"    float t = max(-n.z, 0.0);\n"
	"    n.x += n.x >= 0.0 ? -t : t;\n"
	"    n.y += n.y >= 0.0 ? -t : t;\n"
	"    return normalize(n);\n"
	"}\n"
	"\n"
	"float luma(vec3 c)\n"
	"{\n"
	"    return dot(c, vec3(0.2126, 0.7152, 0.0722));\n"
	"}\n"
	"\n"
	"vec3 eye_ray(ivec2 at)\n"
	"{\n"
	"    vec2 s = 2.0 * (vec2(at) + 0.5 - vec2(pass.corners.xy)) / vec2(pass.corners.zw - pass.corners.xy) - 1.0;\n"
	"    return normalize(pass.camera[1].xyz + s.x * pass.camera[2].xyz + s.y * pass.camera[3].xyz);\n"
	"}\n"
	"\n"
	"/* the last frame's pixel of a point (its camera), or -1 */\n"
	"ivec2 reproject(vec3 p, out float old_distance)\n"
	"{\n"
	"    vec3 v = p - pass.previous[0].xyz;\n"
	"    old_distance = length(v);\n"
	"    float along = dot(v, pass.previous[1].xyz);\n"
	"    if (along <= 0.0)\n"
	"        return ivec2(-1);\n"
	"    vec3 u = v / along - pass.previous[1].xyz;\n"
	"    vec2 ps = vec2(dot(u, pass.previous[2].xyz) / dot(pass.previous[2].xyz, pass.previous[2].xyz),\n"
	"        dot(u, pass.previous[3].xyz) / dot(pass.previous[3].xyz, pass.previous[3].xyz));\n"
	"    vec2 pixel = vec2(pass.previous_corners.xy) + (ps + 1.0) * 0.5 *\n"
	"        vec2(pass.previous_corners.zw - pass.previous_corners.xy);\n"
	"    ivec2 q = ivec2(floor(pixel));\n"
	"    if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, pass.size.xy)))\n"
	"        return ivec2(-1);\n"
	"    return q;\n"
	"}\n"
	"\n"
	"/* the path tracer's spatial pass, an edge-avoiding a-trous wavelet (5x5,\n"
	"B3 spline, steps 1, 2 and 4): weighed by the neighbours' distances and\n"
	"normals and by their static light's ratio (less where the history is long);\n"
	"the last writes what the surfaces read: x the factor of CE's light (the\n"
	"ratio, held within 0.25 to 1.5, by the mood), yzw the light added (held\n"
	"within +-0.35, by the mood) */\n"
	"void main()\n"
	"{\n"
	"    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);\n"
	"    ivec2 full = pass.size.xy;\n"
	"    if (texel.x >= full.x || texel.y >= full.y)\n"
	"        return;\n"
	"    vec4 c0 = texelFetch(in0, texel, 0), c1 = texelFetch(in1, texel, 0);\n"
	"    uvec4 w = texelFetch(inputs, texel, 0);\n"
	"    float distance = uintBitsToFloat(w.z);\n"
	"    bool present = (w.y & 0x400u) != 0u && distance > 0.0;\n"
	"    if (present && pass.info.y != 2u)\n"
	"    {\n"
	"        vec3 n = unfold(unpackSnorm2x16(w.x));\n"
	"        /* (the texel's own ratio, or none where it has no samples: its\n"
	"        neighbours alone, unweighed by it) */\n"
	"        float ratio = c0.z > 0.0 ? c0.x / max(c0.y, 1.0e-4) : -1.0;\n"
	"        float sigma = 0.25 + 1.5 / max(c0.z, 1.0);\n"
	"        const float kernel[3] = float[3](0.375, 0.25, 0.0625);\n"
	"        vec4 s0 = vec4(0.0), s1 = vec4(0.0);\n"
	"        float weights = 0.0;\n"
	"        for (int j = -2; j <= 2; j++)\n"
	"            for (int i = -2; i <= 2; i++)\n"
	"            {\n"
	"                ivec2 q = texel + ivec2(i, j) * step.step;\n"
	"                if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, full)))\n"
	"                    continue;\n"
	"                uvec4 wq = texelFetch(inputs, q, 0);\n"
	"                float dq = uintBitsToFloat(wq.z);\n"
	"                if ((wq.y & 0x400u) == 0u || !(dq > 0.0) || (wq.y & 0x100u) != (w.y & 0x100u))\n"
	"                    continue;\n"
	"                vec4 q0 = texelFetch(in0, q, 0), q1 = texelFetch(in1, q, 0);\n"
	"                /* (no samples yet: none to give) */\n"
	"                if (q0.z <= 0.0)\n"
	"                    continue;\n"
	"                vec3 nq = unfold(unpackSnorm2x16(wq.x));\n"
	"                float along = max(dot(n, nq), 0.0);\n"
	"                along *= along; along *= along; along *= along;\n"
	"                float relative = abs(dq / distance - 1.0) * 40.0;\n"
	"                float rq = q0.x / max(q0.y, 1.0e-4);\n"
	"                float wr = ratio < 0.0 ? 1.0 : exp(-abs(rq - ratio) / sigma);\n"
	"                float weight = kernel[abs(i)] * kernel[abs(j)] * along * wr / (1.0 + relative * relative);\n"
	"                s0 += weight * vec4(q0.xy, 0.0, 0.0);\n"
	"                s1 += weight * q1;\n"
	"                weights += weight;\n"
	"            }\n"
	"        if (weights > 1.0e-6)\n"
	"        {\n"
	"            c0.xy = s0.xy / weights;\n"
	"            c1.xyz = s1.xyz / weights;\n"
	"            c0.z = max(c0.z, 1.0);\n"
	"        }\n"
	"    }\n"
	"    if (step.last == 0)\n"
	"    {\n"
	"        imageStore(out0, texel, c0);\n"
	"        imageStore(out1, texel, c1);\n"
	"        return;\n"
	"    }\n"
	"    if (!present)\n"
	"    {\n"
	"        imageStore(result, texel, vec4(1.0, 0.0, 0.0, 0.0));\n"
	"        return;\n"
	"    }\n"
	"    float mood = pass.pt2.x;\n"
	"    /* (held: the level within 0.4 to 1.1 of CE's light (past 1 is mostly\n"
	"    the two estimates' own difference: at night the lamps' glows rose by a\n"
	"    fifth), an object's within\n"
	"    0.6 to 1.25, as gi holds it: CE lit a model's insides by one flat\n"
	"    ambient, which the traced sky would take nearly all of) */\n"
	"    bool level = (w.y & 0x100u) != 0u;\n"
	"    float factor = c0.y > 1.0e-4 ? clamp(c0.x / c0.y, level ? 0.4 : 0.6, level ? 1.1 : 1.25) : 1.0;\n"
	"    factor = mix(1.0, factor, mood);\n"
	"    vec3 add = c1.xyz * mood;\n"
	"    float y = luma(add);\n"
	"    if (y > 0.35)\n"
	"        add *= 0.35 / y;\n"
	"    add = max(add, vec3(-0.35));\n"
	"    if (any(isnan(add)) || isnan(factor))\n"
	"    {\n"
	"        factor = 1.0;\n"
	"        add = vec3(0.0);\n"
	"    }\n"
	"    /* (debug.prism_rt_view: 1 the factor alone, 2 the added light alone,\n"
	"    brightened) */\n"
	"    uint view = pass.info.w;\n"
	"    if (view == 1u)\n"
	"        add = vec3(0.0);\n"
	"    else if (view == 2u)\n"
	"    {\n"
	"        factor = 0.0;\n"
	"        add = max(c1.xyz, vec3(0.0)) * 4.0 + max(-c1.xyz, vec3(0.0)) * vec3(4.0, 0.0, 0.0);\n"
	"    }\n"
	"    imageStore(result, texel, vec4(factor, add));\n"
	"}\n";
