/* display.prism_rt's compute passes (xgpu_vulkan_rt.c; docs/prism_rt.md),
in Vulkan's GLSL: tools/vulkan_rt_shaders.py makes xgpu_vulkan_rt_shaders.c
of them. Not compiled into the game.

Both read world AO's pre-pass inputs (xgpu.h's XGPU_AMBIENT_OCCLUSION_WORLD_
INPUTS: each pixel's octahedral normal, its flags with the lightmap pass's
bit, its distance from the eye) and the pass block (struct rt_pass in
xgpu_vulkan_rt.c, field for field). A texel of the output is a pixel's, or
at scale 2 its 2x2 block's nearest drawn pixel's, as world AO's pass finds
it (world_ao_shading.c's world_ao_pass_position).

trace: at each texel, rays through the frame's acceleration structure (a
ray query each, no pipeline): toward the sun, the moving casters (the
objects' instances, mask 4) and the structure (mask 1), and about the
normal for the ambient occlusion (the level's pixels: the objects alone, it
never darkens itself; the objects': the objects, their own creases among
them, and the structure close by). Written raw: x the sun's visibility
through the objects, y through the structure, z the occlusion, w the
pixel's distance (0 none).

resolve: the raw texels filtered (a 3x3 cross-bilateral by distance and
normal, display.prism_rt_denoiser "spatiotemporal"; none otherwise),
blended into the last frame's (reprojected by its camera, kept where the
distance is within 5%: "temporal" and "spatiotemporal"), and written as
world AO's pass writes its texels (x the light's factor the surfaces'
occlusion slot multiplies, y the distance, zw the octahedral normal), so
the surfaces read it unchanged: the sun's share CE's lightmap gave
(strength.x of a sunlit lightmap's, strength.y of a model's) taken where
an object blocks it and the structure does not (CE's own shadows are in the
lightmap: never darkened again), times the occlusion. */

static const char trace_source[] =
	"#version 460\n"
	"#extension GL_EXT_ray_query : require\n"
	"layout(local_size_x = 8, local_size_y = 8) in;\n"
	"layout(set = 0, binding = 0) uniform usampler2D inputs;\n"
	"layout(set = 0, binding = 1) uniform accelerationStructureEXT scene;\n"
	"layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D raw;\n"
	"layout(set = 0, binding = 4, std430) readonly buffer Probes { vec4 probes[]; };\n"
	"layout(set = 0, binding = 3, std140) uniform Pass\n"
	"{\n"
	"    vec4 camera[4];\n"
	"    ivec4 corners;\n"
	"    vec4 previous[4];\n"
	"    ivec4 previous_corners;\n"
	"    vec4 sun;\n"
	"    vec4 strength;\n"
	"    vec4 rays;\n"
	"    uvec4 info;\n"
	"    ivec4 size;\n"
	"    vec4 probe_origin;\n"
	"    ivec4 probe_count;\n"
	"    uvec4 probe_info;\n"
	"    vec4 sky;\n"
	"    vec4 sun_radiance;\n"
	"    uvec4 addresses;\n"
	"    uvec4 addresses2;\n"
	"} pass;\n"
	"\n"
	"vec3 unfold(vec2 f)\n"
	"{\n"
	"    vec3 n = vec3(f, 1.0 - abs(f.x) - abs(f.y));\n"
	"    float t = max(-n.z, 0.0);\n"
	"    n.x += n.x >= 0.0 ? -t : t;\n"
	"    n.y += n.y >= 0.0 ? -t : t;\n"
	"    return normalize(n);\n"
	"}\n"
	"\n"
	"float hash(uvec3 v)\n"
	"{\n"
	"    v = v * 1664525u + 1013904223u;\n"
	"    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;\n"
	"    v ^= v >> 16u;\n"
	"    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;\n"
	"    return float(v.x & 0xffffffu) / 16777216.0;\n"
	"}\n"
	"\n"
	"bool blocked(vec3 origin, vec3 direction, float t_max, uint mask)\n"
	"{\n"
	"    rayQueryEXT q;\n"
	"    rayQueryInitializeEXT(q, scene, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT, mask,\n"
	"        origin, 0.0, direction, t_max);\n"
	"    while (rayQueryProceedEXT(q)) { }\n"
	"    return rayQueryGetIntersectionTypeEXT(q, true) != gl_RayQueryCommittedIntersectionNoneEXT;\n"
	"}\n"
	"\n"
	"float nearest(vec3 origin, vec3 direction, float t_max, uint mask)\n"
	"{\n"
	"    rayQueryEXT q;\n"
	"    rayQueryInitializeEXT(q, scene, gl_RayFlagsOpaqueEXT, mask, origin, 0.0, direction, t_max);\n"
	"    while (rayQueryProceedEXT(q)) { }\n"
	"    if (rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionNoneEXT)\n"
	"        return t_max;\n"
	"    return rayQueryGetIntersectionTEXT(q, true);\n"
	"}\n"
	"\n"
	"/* the probes' irradiance (L1 spherical harmonics, a channel each) at a\n"
	"point, trilinear over the 8 probes about it that are inside the volume and\n"
	"valid: rgb along n, and its mean over the sphere */\n"
	"void probe_irradiance(vec3 p, vec3 n, out vec3 along, out vec3 mean)\n"
	"{\n"
	"    vec3 f = p / pass.probe_origin.w;\n"
	"    ivec3 g0 = ivec3(floor(f));\n"
	"    vec3 t = f - vec3(g0);\n"
	"    ivec3 o = ivec3(floor(pass.probe_origin.xyz / pass.probe_origin.w + 0.5));\n"
	"    ivec3 n3 = pass.probe_count.xyz;\n"
	"    vec4 sum[3] = vec4[3](vec4(0.0), vec4(0.0), vec4(0.0));\n"
	"    float weights = 0.0;\n"
	"    for (int c = 0; c < 8; c++)\n"
	"    {\n"
	"        ivec3 d = ivec3(c & 1, (c >> 1) & 1, (c >> 2) & 1);\n"
	"        ivec3 g = g0 + d;\n"
	"        if (any(lessThan(g, o)) || any(greaterThanEqual(g, o + n3)))\n"
	"            continue;\n"
	"        ivec3 slot = ((g % n3) + n3) % n3;\n"
	"        int index = (slot.z * n3.y + slot.y) * n3.x + slot.x;\n"
	"        vec4 where = probes[index * 4 + 3];\n"
	"        if (where.w <= 0.0 || any(greaterThan(abs(where.xyz - vec3(g) * pass.probe_origin.w), vec3(0.01))))\n"
	"            continue;\n"
	"        vec3 w3 = mix(1.0 - t, t, vec3(d));\n"
	"        float w = w3.x * w3.y * w3.z;\n"
	"        sum[0] += w * probes[index * 4];\n"
	"        sum[1] += w * probes[index * 4 + 1];\n"
	"        sum[2] += w * probes[index * 4 + 2];\n"
	"        weights += w;\n"
	"    }\n"
	"    along = vec3(0.0);\n"
	"    mean = vec3(0.0);\n"
	"    if (weights <= 1.0e-4)\n"
	"        return;\n"
	"    vec4 y = vec4(0.886227, 1.023327 * n.y, 1.023327 * n.z, 1.023327 * n.x);\n"
	"    for (int k = 0; k < 3; k++)\n"
	"    {\n"
	"        vec4 c = sum[k] / weights;\n"
	"        along[k] = max(dot(c, y), 0.0);\n"
	"        mean[k] = c.x * 0.886227;\n"
	"    }\n"
	"}\n"
	"\n"
	"void main()\n"
	"{\n"
	"    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);\n"
	"    int scale = pass.size.z;\n"
	"    ivec2 full = pass.size.xy;\n"
	"    if (texel.x >= (full.x + scale - 1) / scale || texel.y >= (full.y + scale - 1) / scale)\n"
	"        return;\n"
	"    uvec4 best = uvec4(0u);\n"
	"    ivec2 at = texel * scale;\n"
	"    float best_distance = 3.0e38;\n"
	"    for (int j = 0; j < scale; j++)\n"
	"        for (int i = 0; i < scale; i++)\n"
	"        {\n"
	"            ivec2 p = min(texel * scale + ivec2(i, j), full - 1);\n"
	"            uvec4 w = texelFetch(inputs, p, 0);\n"
	"            float d = uintBitsToFloat(w.z);\n"
	"            if ((w.y & 0x400u) != 0u && d > 0.0 && d < best_distance)\n"
	"            {\n"
	"                best = w;\n"
	"                best_distance = d;\n"
	"                at = p;\n"
	"            }\n"
	"        }\n"
	"    if ((best.y & 0x400u) == 0u)\n"
	"    {\n"
	"        imageStore(raw, texel, vec4(1.0, 1.0, 1.0, 0.0));\n"
	"        return;\n"
	"    }\n"
	"    vec3 n = unfold(unpackSnorm2x16(best.x));\n"
	"    bool level = (best.y & 0x100u) != 0u;\n"
	"    vec2 s = 2.0 * (vec2(at) + 0.5 - vec2(pass.corners.xy)) / vec2(pass.corners.zw - pass.corners.xy) - 1.0;\n"
	"    vec3 ray = normalize(pass.camera[1].xyz + s.x * pass.camera[2].xyz + s.y * pass.camera[3].xyz);\n"
	"    vec3 p = pass.camera[0].xyz + best_distance * ray;\n"
	"    /* (a surface seen from behind: its normal toward the eye) */\n"
	"    if (dot(n, ray) > 0.0)\n"
	"        n = -n;\n"
	"    /* (an object's own coarse facets shadow it where its smooth normal\n"
	"    leans past them: pushed further off its surface) */\n"
	"    float bias = (level ? 0.02 : 0.05) + 0.0015 * best_distance;\n"
	"    vec3 origin = p + n * bias;\n"
	"    uint frame = pass.info.x;\n"
	"    float v_m = 1.0, v_s = 1.0;\n"
	"    int sun_rays = int(pass.rays.x);\n"
	"    if (pass.sun.w > 0.0 && dot(n, pass.sun.xyz) > 0.0)\n"
	"    {\n"
	"        vec3 t = normalize(abs(pass.sun.z) < 0.95 ? cross(pass.sun.xyz, vec3(0.0, 0.0, 1.0)) :\n"
	"            cross(pass.sun.xyz, vec3(1.0, 0.0, 0.0)));\n"
	"        vec3 b = cross(pass.sun.xyz, t);\n"
	"        float m = 0.0;\n"
	"        for (int r = 0; r < sun_rays; r++)\n"
	"        {\n"
	"            float u = hash(uvec3(uvec2(at), frame * 8u + uint(r)));\n"
	"            float a = hash(uvec3(uvec2(at) + 7u, frame * 8u + uint(r) + 3u)) * 6.2831853;\n"
	"            vec3 d = normalize(pass.sun.xyz + pass.strength.z * sqrt(u) * (cos(a) * t + sin(a) * b));\n"
	"            /* (a ray takes the sun only where an object blocks it and the\n"
	"            structure does not: the structure's ray only after an object's hit) */\n"
	"            m += blocked(origin, d, pass.rays.z, 4u) && !blocked(origin, d, pass.rays.w, 1u) ? 0.0 : 1.0;\n"
	"        }\n"
	"        v_m = m / float(max(sun_rays, 1));\n"
	"    }\n"

	"    /* the ambient occlusion: cosine-weighted rays about the normal, a hit at\n"
	"    t counting 1 - (t / reach)^2, as world AO's traced objects count */\n"
	"    int ao_rays = int(pass.rays.y);\n"
	"    float reach = level ? 2.0 : 1.0;\n"
	"    float occluded = 0.0;\n"
	"    vec3 t0 = normalize(abs(n.z) < 0.95 ? cross(n, vec3(0.0, 0.0, 1.0)) : cross(n, vec3(1.0, 0.0, 0.0)));\n"
	"    vec3 b0 = cross(n, t0);\n"
	"    for (int r = 0; r < ao_rays; r++)\n"
	"    {\n"
	"        float u = (float(r) + hash(uvec3(uvec2(at), frame * 16u + uint(r) + 101u))) / float(ao_rays);\n"
	"        float a = hash(uvec3(uvec2(at) + 13u, frame * 16u + uint(r) + 57u)) * 6.2831853;\n"
	"        vec3 d = normalize(sqrt(u) * (cos(a) * t0 + sin(a) * b0) + sqrt(max(1.0 - u, 0.0)) * n);\n"
	"        float hit = nearest(origin, d, reach, 4u);\n"
	"        /* (an object's: the structure close by too, its half a world unit\n"
	"        counted over the whole reach) */\n"
	"        if (!level)\n"
	"        {\n"
	"            float near_structure = nearest(origin, d, 0.5, 1u);\n"
	"            if (near_structure < 0.5)\n"
	"                hit = min(hit, reach * near_structure / 0.5);\n"
	"        }\n"
	"        if (hit < reach)\n"
	"            occluded += 1.0 - (hit / reach) * (hit / reach);\n"
	"    }\n"
	"    float ao = ao_rays > 0 ? 1.0 - occluded / float(ao_rays) : 1.0;\n"
	"    /* (gi: an object's light shaded by the probes' indirect light along its\n"
	"    normal against their mean, so its brightness stays CE's and only how it\n"
	"    falls across the object changes: within 1/k to k, k by the mood) */\n"
	"    if (pass.probe_info.w != 0u && !level)\n"
	"    {\n"
	"        vec3 along, mean;\n"
	"        probe_irradiance(p + n * 0.25, n, along, mean);\n"
	"        float y_along = dot(along, vec3(0.2126, 0.7152, 0.0722));\n"
	"        float y_mean = dot(mean, vec3(0.2126, 0.7152, 0.0722));\n"
	"        float k = 1.0 + 0.25 * float(pass.probe_info.z) / 100.0;\n"
	"        if (y_mean > 1.0e-5)\n"
	"            ao *= clamp(y_along / y_mean, 1.0 / k, k);\n"
	"        /* (debug.prism_rt_view probes: the probes found (white), none (grey),\n"
	"        and their ratio's reach) */\n"
	"        if (pass.info.w == 4u)\n"
	"            v_m = y_mean > 1.0e-5 ? clamp(0.5 + 2.0 * (y_along / y_mean - 1.0), 0.0, 1.0) : 0.1;\n"
	"    }\n"
	"    imageStore(raw, texel, vec4(v_m, v_s, ao, best_distance));\n"
	"}\n";

static const char resolve_source[] =
	"#version 460\n"
	"layout(local_size_x = 8, local_size_y = 8) in;\n"
	"layout(set = 0, binding = 0) uniform usampler2D inputs;\n"
	"layout(set = 0, binding = 1) uniform sampler2D raw;\n"
	"layout(set = 0, binding = 2) uniform sampler2D history;\n"
	"layout(set = 0, binding = 3, rgba32f) uniform writeonly image2D state;\n"
	"layout(set = 0, binding = 4, rgba32f) uniform writeonly image2D result;\n"
	"layout(set = 0, binding = 5, std140) uniform Pass\n"
	"{\n"
	"    vec4 camera[4];\n"
	"    ivec4 corners;\n"
	"    vec4 previous[4];\n"
	"    ivec4 previous_corners;\n"
	"    vec4 sun;\n"
	"    vec4 strength;\n"
	"    vec4 rays;\n"
	"    uvec4 info;\n"
	"    ivec4 size;\n"
	"    vec4 probe_origin;\n"
	"    ivec4 probe_count;\n"
	"    uvec4 probe_info;\n"
	"    vec4 sky;\n"
	"    vec4 sun_radiance;\n"
	"    uvec4 addresses;\n"
	"    uvec4 addresses2;\n"
	"} pass;\n"
	"\n"
	"vec3 unfold(vec2 f)\n"
	"{\n"
	"    vec3 n = vec3(f, 1.0 - abs(f.x) - abs(f.y));\n"
	"    float t = max(-n.z, 0.0);\n"
	"    n.x += n.x >= 0.0 ? -t : t;\n"
	"    n.y += n.y >= 0.0 ? -t : t;\n"
	"    return normalize(n);\n"
	"}\n"
	"\n"
	"void main()\n"
	"{\n"
	"    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);\n"
	"    int scale = pass.size.z;\n"
	"    ivec2 full = pass.size.xy;\n"
	"    ivec2 extent = (full + scale - 1) / scale;\n"
	"    if (texel.x >= extent.x || texel.y >= extent.y)\n"
	"        return;\n"
	"    vec4 centre = texelFetch(raw, texel, 0);\n"
	"    /* (the texel's pixel again: the 2x2 block's nearest, its inputs) */\n"
	"    uvec4 best = uvec4(0u);\n"
	"    ivec2 at = texel * scale;\n"
	"    float best_distance = 3.0e38;\n"
	"    for (int j = 0; j < scale; j++)\n"
	"        for (int i = 0; i < scale; i++)\n"
	"        {\n"
	"            ivec2 p = min(texel * scale + ivec2(i, j), full - 1);\n"
	"            uvec4 w = texelFetch(inputs, p, 0);\n"
	"            float d = uintBitsToFloat(w.z);\n"
	"            if ((w.y & 0x400u) != 0u && d > 0.0 && d < best_distance)\n"
	"            {\n"
	"                best = w;\n"
	"                best_distance = d;\n"
	"                at = p;\n"
	"            }\n"
	"        }\n"
	"    /* (the raw texel's distance is a half float: the inputs' is whole) */\n"
	"    centre.w = (best.y & 0x400u) != 0u ? best_distance : 0.0;\n"
	"    if (centre.w <= 0.0)\n"
	"    {\n"
	"        imageStore(state, texel, vec4(1.0, 1.0, 1.0, 0.0));\n"
	"        imageStore(result, texel, vec4(1.0, 0.0, 0.0, 0.0));\n"
	"        return;\n"
	"    }\n"
	"    vec2 octahedral = unpackSnorm2x16(best.x);\n"
	"    vec3 n = unfold(octahedral);\n"
	"    bool level = (best.y & 0x100u) != 0u;\n"
	"    vec4 value = centre;\n"
	"    /* (spatial: a 3x3 cross-bilateral by the neighbours' distances and\n"
	"    normals, as world AO's upsample weighs them) */\n"
	"    if (pass.info.y == 0u)\n"
	"    {\n"
	"        vec3 sum = vec3(0.0);\n"
	"        float weights = 0.0;\n"
	"        for (int j = -1; j <= 1; j++)\n"
	"            for (int i = -1; i <= 1; i++)\n"
	"            {\n"
	"                ivec2 q = clamp(texel + ivec2(i, j), ivec2(0), extent - 1);\n"
	"                vec4 other = texelFetch(raw, q, 0);\n"
	"                if (other.w <= 0.0)\n"
	"                    continue;\n"
	"                uvec4 w = texelFetch(inputs, min(q * scale, full - 1), 0);\n"
	"                vec3 on = unfold(unpackSnorm2x16(w.x));\n"
	"                float relative = abs(other.w / centre.w - 1.0) * 50.0;\n"
	"                float along = max(dot(n, on), 0.0);\n"
	"                along *= along; along *= along;\n"
	"                float weight = along / (1.0 + relative * relative) * exp(-0.18 * float(i * i + j * j));\n"
	"                sum += weight * other.xyz;\n"
	"                weights += weight;\n"
	"            }\n"
	"        if (weights > 1.0e-4)\n"
	"            value.xyz = sum / weights;\n"
	"    }\n"
	"    /* (temporal: the last frame's at the point, reprojected by its camera) */\n"
	"    if (pass.info.z != 0u && pass.info.y != 2u)\n"
	"    {\n"
	"        vec2 s = 2.0 * (vec2(at) + 0.5 - vec2(pass.corners.xy)) / vec2(pass.corners.zw - pass.corners.xy) - 1.0;\n"
	"        vec3 ray = normalize(pass.camera[1].xyz + s.x * pass.camera[2].xyz + s.y * pass.camera[3].xyz);\n"
	"        vec3 p = pass.camera[0].xyz + centre.w * ray;\n"
	"        vec3 v = p - pass.previous[0].xyz;\n"
	"        float along = dot(v, pass.previous[1].xyz);\n"
	"        if (along > 0.0)\n"
	"        {\n"
	"            vec3 u = v / along - pass.previous[1].xyz;\n"
	"            vec2 ps = vec2(dot(u, pass.previous[2].xyz) / dot(pass.previous[2].xyz, pass.previous[2].xyz),\n"
	"                dot(u, pass.previous[3].xyz) / dot(pass.previous[3].xyz, pass.previous[3].xyz));\n"
	"            vec2 pixel = vec2(pass.previous_corners.xy) + (ps + 1.0) * 0.5 *\n"
	"                vec2(pass.previous_corners.zw - pass.previous_corners.xy);\n"
	"            vec2 uv = pixel / vec2(scale) / vec2(extent);\n"
	"            if (all(greaterThanEqual(uv, vec2(0.0))) && all(lessThan(uv, vec2(1.0))))\n"
	"            {\n"
	"                vec4 old = texelFetch(history, ivec2(uv * vec2(extent)), 0);\n"
	"                float old_distance = length(v);\n"
	"                if (old.w > 0.0 && abs(old.w - old_distance) < 0.05 * old_distance)\n"
	"                {\n"
	"                    float alpha = pass.strength.w;\n"
	"                    value.xyz = mix(old.xyz, value.xyz, alpha);\n"
	"                }\n"
	"            }\n"
	"        }\n"
	"    }\n"
	"    imageStore(state, texel, vec4(value.xyz, centre.w));\n"
	"    float facing = level ? smoothstep(0.0, 0.25, dot(n, pass.sun.xyz)) :\n"
	"        smoothstep(0.1, 0.4, dot(n, pass.sun.xyz));\n"
	"    float share = level ? pass.strength.x : pass.strength.y;\n"
	"    float shadow = 1.0 - share * (1.0 - value.x) * value.y * facing * pass.sun.w;\n"
	"    /* (the occlusion's strength: the level's by the objects, an object's by\n"
	"    everything; gi's ratio is in it, past 1 where the probes say so) */\n"
	"    float ao = level ? mix(1.0, max(value.z, 0.2), 0.7) : mix(1.0, max(value.z, 0.3), 0.6);\n"
	"    uint view = pass.info.w;\n"
	"    float light = view == 1u ? shadow : view == 2u ? ao : view == 3u ? value.y : view == 4u ? value.x :\n"
	"        shadow * ao;\n"
	"    imageStore(result, texel, vec4(light, centre.w, octahedral));\n"
	"}\n";

static const char probes_source[] =
	"#version 460\n"
	"#extension GL_EXT_ray_query : require\n"
	"#extension GL_EXT_buffer_reference : require\n"
	"#extension GL_EXT_buffer_reference_uvec2 : require\n"
	"layout(local_size_x = 64) in;\n"
	"layout(set = 0, binding = 0) uniform accelerationStructureEXT scene;\n"
	"layout(set = 0, binding = 1, std430) buffer Probes { vec4 probes[]; };\n"
	"layout(set = 0, binding = 2, std140) uniform Pass\n"
	"{\n"
	"    vec4 camera[4];\n"
	"    ivec4 corners;\n"
	"    vec4 previous[4];\n"
	"    ivec4 previous_corners;\n"
	"    vec4 sun;\n"
	"    vec4 strength;\n"
	"    vec4 rays;\n"
	"    uvec4 info;\n"
	"    ivec4 size;\n"
	"    vec4 probe_origin;\n"
	"    ivec4 probe_count;\n"
	"    uvec4 probe_info;\n"
	"    vec4 sky;\n"
	"    vec4 sun_radiance;\n"
	"    uvec4 addresses;\n"
	"    uvec4 addresses2;\n"
	"} pass;\n"
	"layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Floats { float v[]; };\n"
	"layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Uints { uint v[]; };\n"
	"shared vec4 sh[64][3];\n"
	"shared float backs[64];\n"
	"\n"
	"float hash(uvec3 v)\n"
	"{\n"
	"    v = v * 1664525u + 1013904223u;\n"
	"    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;\n"
	"    v ^= v >> 16u;\n"
	"    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;\n"
	"    return float(v.x & 0xffffffu) / 16777216.0;\n"
	"}\n"
	"\n"
	"vec3 corner(uint custom, uint primitive, uint k)\n"
	"{\n"
	"    if (custom == 0u)\n"
	"    {\n"
	"        Floats f = Floats(pass.addresses.xy);\n"
	"        uint b = (primitive * 3u + k) * 3u;\n"
	"        return vec3(f.v[b], f.v[b + 1u], f.v[b + 2u]);\n"
	"    }\n"
	"    Uints i = Uints(pass.addresses2.xy);\n"
	"    Floats f = Floats(pass.addresses.zw);\n"
	"    uint b = i.v[primitive * 3u + k] * 3u;\n"
	"    return vec3(f.v[b], f.v[b + 1u], f.v[b + 2u]);\n"
	"}\n"
	"\n"
	"/* the last irradiance about a point along n (this buffer's: the probes\n"
	"updated meanwhile as they are) */\n"
	"vec3 irradiance(vec3 p, vec3 n)\n"
	"{\n"
	"    vec3 f = p / pass.probe_origin.w;\n"
	"    ivec3 g0 = ivec3(floor(f));\n"
	"    vec3 t = f - vec3(g0);\n"
	"    ivec3 o = ivec3(floor(pass.probe_origin.xyz / pass.probe_origin.w + 0.5));\n"
	"    ivec3 n3 = pass.probe_count.xyz;\n"
	"    vec3 sum = vec3(0.0);\n"
	"    float weights = 0.0;\n"
	"    vec4 y = vec4(0.886227, 1.023327 * n.y, 1.023327 * n.z, 1.023327 * n.x);\n"
	"    for (int c = 0; c < 8; c++)\n"
	"    {\n"
	"        ivec3 d = ivec3(c & 1, (c >> 1) & 1, (c >> 2) & 1);\n"
	"        ivec3 g = g0 + d;\n"
	"        if (any(lessThan(g, o)) || any(greaterThanEqual(g, o + n3)))\n"
	"            continue;\n"
	"        ivec3 slot = ((g % n3) + n3) % n3;\n"
	"        int index = (slot.z * n3.y + slot.y) * n3.x + slot.x;\n"
	"        vec4 where = probes[index * 4 + 3];\n"
	"        if (where.w <= 0.0 || any(greaterThan(abs(where.xyz - vec3(g) * pass.probe_origin.w), vec3(0.01))))\n"
	"            continue;\n"
	"        vec3 w3 = mix(1.0 - t, t, vec3(d));\n"
	"        float w = w3.x * w3.y * w3.z;\n"
	"        sum += w * vec3(max(dot(probes[index * 4], y), 0.0), max(dot(probes[index * 4 + 1], y), 0.0),\n"
	"            max(dot(probes[index * 4 + 2], y), 0.0));\n"
	"        weights += w;\n"
	"    }\n"
	"    return weights > 1.0e-4 ? sum / weights : vec3(0.0);\n"
	"}\n"
	"\n"
	"void main()\n"
	"{\n"
	"    uint total = uint(pass.probe_count.w);\n"
	"    uint index = (pass.probe_info.x + gl_WorkGroupID.x) % total;\n"
	"    uint lane = gl_LocalInvocationID.x;\n"
	"    ivec3 n3 = pass.probe_count.xyz;\n"
	"    ivec3 slot = ivec3(int(index) % n3.x, (int(index) / n3.x) % n3.y, int(index) / (n3.x * n3.y));\n"
	"    ivec3 o = ivec3(floor(pass.probe_origin.xyz / pass.probe_origin.w + 0.5));\n"
	"    /* (the cell this slot holds now: the one in the volume it stands for) */\n"
	"    ivec3 g = o + (((slot - o) % n3) + n3) % n3;\n"
	"    vec3 p = vec3(g) * pass.probe_origin.w;\n"
	"    uint ray_count = pass.probe_info.y;\n"
	"    vec4 acc[3] = vec4[3](vec4(0.0), vec4(0.0), vec4(0.0));\n"
	"    float back = 0.0;\n"
	"    float spin = hash(uvec3(index, pass.info.x, 17u)) * 6.2831853;\n"
	"    for (uint r = lane; r < ray_count; r += 64u)\n"
	"    {\n"
	"        /* a spherical Fibonacci direction, turned each frame */\n"
	"        float i = float(r) + 0.5;\n"
	"        float z = 1.0 - 2.0 * i / float(ray_count);\n"
	"        float a = 2.3999632 * i + spin;\n"
	"        float rr = sqrt(max(1.0 - z * z, 0.0));\n"
	"        vec3 d = vec3(rr * cos(a), rr * sin(a), z);\n"
	"        vec3 radiance = pass.sky.rgb;\n"
	"        rayQueryEXT q;\n"
	"        rayQueryInitializeEXT(q, scene, gl_RayFlagsOpaqueEXT, 5u, p, 0.0, d, 64.0);\n"
	"        while (rayQueryProceedEXT(q)) { }\n"
	"        if (rayQueryGetIntersectionTypeEXT(q, true) != gl_RayQueryCommittedIntersectionNoneEXT)\n"
	"        {\n"
	"            uint custom = rayQueryGetIntersectionInstanceCustomIndexEXT(q, true);\n"
	"            uint primitive = uint(rayQueryGetIntersectionPrimitiveIndexEXT(q, true));\n"
	"            float t = rayQueryGetIntersectionTEXT(q, true);\n"
	"            vec3 a0 = corner(custom, primitive, 0u), a1 = corner(custom, primitive, 1u),\n"
	"                a2 = corner(custom, primitive, 2u);\n"
	"            vec3 nh = cross(a1 - a0, a2 - a0);\n"
	"            nh = dot(nh, nh) > 1.0e-20 ? normalize(nh) : -d;\n"
	"            /* (the level's faces are one-sided: a probe seeing their backs is\n"
	"            inside it; an object's are two-sided) */\n"
	"            if (dot(nh, d) > 0.0)\n"
	"            {\n"
	"                if (custom == 0u)\n"
	"                {\n"
	"                    back += 1.0;\n"
	"                    radiance = vec3(0.0);\n"
	"                    nh = vec3(0.0);\n"
	"                }\n"
	"                else\n"
	"                    nh = -nh;\n"
	"            }\n"
	"            if (dot(nh, nh) > 0.0)\n"
	"            {\n"
	"                vec3 h = p + d * t + nh * 0.03;\n"
	"                float lit = max(dot(nh, pass.sun.xyz), 0.0) * pass.sun.w;\n"
	"                if (lit > 0.0)\n"
	"                {\n"
	"                    rayQueryEXT s;\n"
	"                    rayQueryInitializeEXT(s, scene, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT, 5u,\n"
	"                        h, 0.0, pass.sun.xyz, 800.0);\n"
	"                    while (rayQueryProceedEXT(s)) { }\n"
	"                    if (rayQueryGetIntersectionTypeEXT(s, true) != gl_RayQueryCommittedIntersectionNoneEXT)\n"
	"                        lit = 0.0;\n"
	"                }\n"
	"                radiance = 0.3 * (pass.sun_radiance.rgb * lit + irradiance(h, nh) * 0.318310);\n"
	"            }\n"
	"        }\n"
	"        vec4 y = vec4(0.282095, 0.488603 * d.y, 0.488603 * d.z, 0.488603 * d.x);\n"
	"        acc[0] += radiance.r * y;\n"
	"        acc[1] += radiance.g * y;\n"
	"        acc[2] += radiance.b * y;\n"
	"    }\n"
	"    sh[lane][0] = acc[0];\n"
	"    sh[lane][1] = acc[1];\n"
	"    sh[lane][2] = acc[2];\n"
	"    backs[lane] = back;\n"
	"    barrier();\n"
	"    for (uint stride = 32u; stride > 0u; stride >>= 1u)\n"
	"    {\n"
	"        if (lane < stride)\n"
	"        {\n"
	"            sh[lane][0] += sh[lane + stride][0];\n"
	"            sh[lane][1] += sh[lane + stride][1];\n"
	"            sh[lane][2] += sh[lane + stride][2];\n"
	"            backs[lane] += backs[lane + stride];\n"
	"        }\n"
	"        barrier();\n"
	"    }\n"
	"    if (lane != 0u)\n"
	"        return;\n"
	"    float scale = 12.566371 / float(ray_count);\n"
	"    vec4 where = probes[index * 4u + 3u];\n"
	"    bool fresh = where.w <= 0.0 || any(greaterThan(abs(where.xyz - p), vec3(0.01)));\n"
	"    /* (inside the level: a quarter of its rays or more saw a face's back) */\n"
	"    bool inside = backs[0] > 0.25 * float(ray_count);\n"
	"    float keep = fresh ? 0.0 : 0.9;\n"
	"    for (int k = 0; k < 3; k++)\n"
	"        probes[index * 4u + uint(k)] = mix(sh[0][k] * scale, probes[index * 4u + uint(k)], keep);\n"
	"    probes[index * 4u + 3u] = vec4(p, inside ? 0.0 : 1.0);\n"
	"}\n";
