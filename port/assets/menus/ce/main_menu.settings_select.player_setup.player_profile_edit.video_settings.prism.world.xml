	<strings name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/prism/world/help_strings">
		<string text=""/>
		<string text=""/>
		<string text="Enhanced draws the levels' rock, sand and Forerunner walls from the release's remodelled world, lit by the lightmaps baked for it; Classic the original's shape. From the next level. Needs Enhanced or Path Traced lighting."/>
		<string text="How far out the enhanced world is drawn in its full detail; beyond, its lighter far level. Low is cheaper on the graphics card."/>
		<string text="Spreads where the enhanced world's surfaces change to their lighter far level over a band, one by one as you move, rather than a ring of them at once."/>
		<string text=""/>
		<string text="Campaign only: what you walk and collide on with the enhanced world. Original: the original game's. From the next level; multiplayer always uses original collision. Arrives in a later update."/>
	</strings>
