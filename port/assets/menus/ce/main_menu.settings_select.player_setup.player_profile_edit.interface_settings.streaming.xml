	<strings name="main_menu/settings_select/player_setup/player_profile_edit/interface_settings/streaming/help_strings">
		<string text=""/>
		<string text=""/>
		<string text="Writes the game's state (map, mode, score, kills, deaths, loading, cutscene, pause) to game_state.json in the game's folder, for stream overlays and scene switchers."/>
		<string text="Draws each player's sticks, trigger and buttons (or keys and mouse) at the bottom right, in demos too. Hide HUD hides it."/>
		<string text=""/>
		<string text="Draws a clock at the bottom right: in multiplayer the game's, counting up from its start; in the campaign and co-op the mission's, which stops while the game is paused."/>
		<string text="Keys that save and load a state and restart the level (game.practice_save_key, _load_key and _restart_key in config.toml). They, a cheat or game_speed show PRACTICE until a fresh start."/>
	</strings>
