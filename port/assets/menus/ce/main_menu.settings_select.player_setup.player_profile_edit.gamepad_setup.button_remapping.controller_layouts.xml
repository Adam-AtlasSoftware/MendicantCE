	<strings name="main_menu/settings_select/player_setup/player_profile_edit/gamepad_setup/button_remapping/controller_layouts/help_strings">
		<string text=""/>
		<string text=""/>
		<string text="The controller of the player whose settings these are, and how many of its paddles and extra buttons its layout describes. Each controller keeps its own layout."/>
		<string text="Name each paddle and extra button, and pick its symbol: a legend of up to 3 characters, a shape and a color. Button Remapping's prompts draw it."/>
		<string text=""/>
		<string text="Export adds your Button Remapping buttons to the file. Whoever imports it still keeps theirs unless they choose yours."/>
		<string text="Saves this controller's layout as a file in the data folder's controller_layouts/shared, to give to another player."/>
		<string text="To import a layout, copy its file into the data folder's controller_layouts: it is read when Edit Buttons opens. A file with a mistake is refused whole."/>
		<string text="This controller's layout came with its owner's Button Remapping buttons. Yours stay unless you choose to use them."/>
	</strings>
