	<strings name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/first_person/camera/help_strings">
		<string text=""/>
		<string text=""/>
		<string text="On foot in the campaign: through your eyes, or from behind your shoulder with your whole body drawn. Shots go where the reticle points. A scope zooms in first person; vehicles keep their own views."/>
		<string text="Third person: how far behind you the camera is, in world units of about 3 meters. Camera Closer and Camera Further (Controls, Camera) change it as you play.|Click the number (or press A) to type any from 1 to 6."/>
		<string text="Third person: how far right of your head the camera is, in world units; below 0 over your left shoulder.|Click the number (or press A) to type any from -0.5 to 0.5."/>
		<string text="Third person in multiplayer games too. Off keeps it to the campaign and co-op: seeing round corners is an advantage the others may not have."/>
	</strings>
