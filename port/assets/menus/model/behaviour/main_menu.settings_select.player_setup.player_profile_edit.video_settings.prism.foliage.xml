	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/prism/foliage/button_defaults">
		<on event="a" run="port settings defaults"/>
		<on event="start" run="port settings defaults"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/prism/foliage/button_ok">
		<on event="a" run="port settings keep" back="true"/>
		<on event="start" run="port settings keep" back="true"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/prism/foliage/button_cancel">
		<on event="a" run="port settings page cancel" back="true"/>
		<on event="start" run="port settings page cancel" back="true"/>
