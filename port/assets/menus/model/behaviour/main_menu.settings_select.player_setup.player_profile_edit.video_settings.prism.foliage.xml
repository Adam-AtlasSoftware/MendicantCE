		<on event="created" run="port setting load"/>
		<on event="a" run="port setting segment"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/prism/foliage/op_foliage_wind" flags="pass_unhandled_to_focused_child"/>
