<?xml version="1.0" encoding="UTF-8"?>
<!-- The behaviour of ce/main_menu.settings_select.player_setup.player_profile_edit.video_settings.prism.foliage.xml's widgets, for the menu engine (docs/menu_engine.md; tools/menu_behaviour.py) -->
<model>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/prism/foliage/foliage_screen" flags="pass_unhandled_to_focused_child pause_game">
		<on event="b" run="port settings page cancel" back="true"/>
		<on event="back" run="port settings page cancel" back="true"/>
		<on event="y" run="port settings search"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/prism/foliage/options_menu" flags="pass_unhandled_to_focused_child up_down_tabs_children"/>
