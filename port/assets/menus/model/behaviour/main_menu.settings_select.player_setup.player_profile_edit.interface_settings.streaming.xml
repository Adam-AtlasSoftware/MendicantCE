<?xml version="1.0" encoding="UTF-8"?>
<!-- The behaviour of ce/main_menu.settings_select.player_setup.player_profile_edit.interface_settings.streaming.xml's widgets, for the menu engine (docs/menu_engine.md; tools/menu_behaviour.py) -->
<model>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/interface_settings/streaming/streaming_screen" flags="pass_unhandled_to_focused_child pause_game">
		<on event="b" run="port settings page cancel" back="true"/>
		<on event="back" run="port settings page cancel" back="true"/>
		<on event="y" run="port settings search"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/interface_settings/streaming/options_menu" flags="pass_unhandled_to_focused_child up_down_tabs_children"/>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/interface_settings/streaming/button_bar" flags="pass_unhandled_to_focused_child left_right_tabs_items"/>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/interface_settings/streaming/button_defaults">
		<on event="a" run="port settings defaults"/>
		<on event="start" run="port settings defaults"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/interface_settings/streaming/button_ok">
		<on event="a" run="port settings keep" back="true"/>
		<on event="start" run="port settings keep" back="true"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/interface_settings/streaming/button_cancel">
		<on event="a" run="port settings page cancel" back="true"/>
		<on event="start" run="port settings page cancel" back="true"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/interface_settings/streaming/op_state_file" flags="pass_unhandled_to_focused_child"/>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/interface_settings/streaming/state_file_spinner" flags="pass_unhandled_to_focused_child left_right_tabs_items">
		<on event="created" run="port setting load"/>
		<on event="a" run="port setting segment"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/interface_settings/streaming/op_input_display" flags="pass_unhandled_to_focused_child"/>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/interface_settings/streaming/input_display_spinner" flags="pass_unhandled_to_focused_child left_right_tabs_items">
		<on event="created" run="port setting load"/>
		<on event="a" run="port setting segment"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/interface_settings/streaming/op_match_timer" flags="pass_unhandled_to_focused_child"/>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/interface_settings/streaming/match_timer_spinner" flags="pass_unhandled_to_focused_child left_right_tabs_items">
		<on event="created" run="port setting load"/>
		<on event="a" run="port setting segment"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/interface_settings/streaming/op_practice_keys" flags="pass_unhandled_to_focused_child"/>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/interface_settings/streaming/practice_keys_spinner" flags="pass_unhandled_to_focused_child left_right_tabs_items">
		<on event="created" run="port setting load"/>
		<on event="a" run="port setting segment"/>
	</behaviour>
</model>
