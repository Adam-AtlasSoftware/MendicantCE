<?xml version="1.0" encoding="UTF-8"?>
<!-- The behaviour of ce/main_menu.settings_select.player_setup.player_profile_edit.video_settings.first_person.camera.xml's widgets, for the menu engine (docs/menu_engine.md; tools/menu_behaviour.py) -->
<model>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/first_person/camera/camera_screen" flags="pass_unhandled_to_focused_child pause_game">
		<on event="b" run="port settings page cancel" back="true"/>
		<on event="back" run="port settings page cancel" back="true"/>
		<on event="y" run="port settings search"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/first_person/camera/options_menu" flags="pass_unhandled_to_focused_child up_down_tabs_children"/>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/first_person/camera/button_bar" flags="pass_unhandled_to_focused_child left_right_tabs_items"/>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/first_person/camera/button_defaults">
		<on event="a" run="port settings defaults"/>
		<on event="start" run="port settings defaults"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/first_person/camera/button_ok">
		<on event="a" run="port settings keep" back="true"/>
		<on event="start" run="port settings keep" back="true"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/first_person/camera/button_cancel">
		<on event="a" run="port settings page cancel" back="true"/>
		<on event="start" run="port settings page cancel" back="true"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/first_person/camera/op_view" flags="pass_unhandled_to_focused_child"/>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/first_person/camera/view_spinner" flags="pass_unhandled_to_focused_child left_right_tabs_items">
		<on event="created" run="port setting load"/>
		<on event="a" run="port setting segment"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/first_person/camera/op_third_person_distance" flags="pass_unhandled_to_focused_child">
		<on event="left" run="port slider left"/>
		<on event="right" run="port slider right"/>
		<on event="a" run="port slider edit"/>
		<on event="start" run="port slider edit"/>
		<on event="left_mouse" run="mouse emit accept event"/>
		<on event="stick_left" run="port slider left"/>
		<on event="stick_right" run="port slider right"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/first_person/camera/op_third_person_shoulder" flags="pass_unhandled_to_focused_child">
		<on event="left" run="port slider left"/>
		<on event="right" run="port slider right"/>
		<on event="a" run="port slider edit"/>
		<on event="start" run="port slider edit"/>
		<on event="left_mouse" run="mouse emit accept event"/>
		<on event="stick_left" run="port slider left"/>
		<on event="stick_right" run="port slider right"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/first_person/camera/op_reticle_assist" flags="pass_unhandled_to_focused_child"/>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/first_person/camera/reticle_assist_spinner" flags="pass_unhandled_to_focused_child left_right_tabs_items">
		<on event="created" run="port setting load"/>
		<on event="a" run="port setting segment"/>
	</behaviour>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/first_person/camera/op_third_person_netgames" flags="pass_unhandled_to_focused_child"/>
	<behaviour name="main_menu/settings_select/player_setup/player_profile_edit/video_settings/first_person/camera/third_person_netgames_spinner" flags="pass_unhandled_to_focused_child left_right_tabs_items">
		<on event="created" run="port setting load"/>
		<on event="a" run="port setting segment"/>
	</behaviour>
</model>
